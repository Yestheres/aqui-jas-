DISCORD_TOKEN=your_bot_token_here

# ID do servidor de teste para sincronização imediata dos slash commands.
# Exemplo: 123456789012345678
DEV_GUILD_ID=

DATABASE_PATH=data/bot.sqlite3
LOG_LEVEL=INFO

# Fallback opcional; cada servidor pode configurar sua própria IA via /configia.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free
